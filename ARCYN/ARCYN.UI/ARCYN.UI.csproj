<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="$(TargetFramework.EndsWith('windows'))">WinExe</OutputType>
    <OutputType Condition="!$(TargetFramework.EndsWith('windows'))">Library</OutputType>
    <RuntimeIdentifier Condition="$(TargetFramework.EndsWith('windows'))">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWpf Condition="$(TargetFramework.EndsWith('windows'))">true</UseWpf>
    <ApplicationIcon />
    <StartupObject Condition="$(TargetFramework.EndsWith('windows'))">ARCYN.UI.App</StartupObject>
    <RootNamespace>ARCYN.UI</RootNamespace>
    <ApplicationManifest Condition="$(TargetFramework.EndsWith('windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.EndsWith('windows'))">
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\example.arcyn.json" Link="example.arcyn.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARCYN.Core\ARCYN.Core.csproj" />
  </ItemGroup>

  <!-- Exclude WPF-only source files when targeting net8.0 (non-Windows) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="**/*.xaml.cs" />
    <Compile Remove="ParticleEngine.cs" />
    <Compile Remove="NativeMethods.cs" />
    <Compile Remove="Services\AnimationService.cs" />
    <Compile Remove="Services\RenderService.cs" />
    <Compile Remove="ViewModels\MainWindowViewModel.cs" />
    <Compile Remove="Converters\**" />
    <EmbeddedResource Remove="**/*.xaml" />
    <Page Remove="**/*.xaml" />
    <Resource Remove="Assets\Fonts\*" />
    <None Remove="Assets\Fonts\*" />
  </ItemGroup>

</Project>
