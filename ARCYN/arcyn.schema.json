{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARCYN Config",
  "description": "Configuration schema for the ARCYN tactical workspace launcher",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema URI for self-validation"
    },
    "theme": {
      "type": "object",
      "description": "Visual theme settings",
      "properties": {
        "accent": {
          "type": "string",
          "description": "Accent color in hex format (e.g. #D64545)",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#D64545"
        },
        "glow_opacity": {
          "type": "number",
          "description": "Ambient glow opacity (0.0 - 1.0)",
          "minimum": 0,
          "maximum": 1,
          "default": 0.28
        },
        "scanlines": {
          "type": "boolean",
          "description": "Show CRT scanline overlay",
          "default": true
        },
        "animations": {
          "type": "boolean",
          "description": "Enable animations and transitions",
          "default": true
        },
        "reduced_effects": {
          "type": "boolean",
          "description": "Disable particles, cursor trail, ambient glow, scanlines, and boot animation (for low-end PCs)",
          "default": false
        },
        "compact_mode": {
          "type": "boolean",
          "description": "Compact card sizing for more modes visible at once",
          "default": false
        }
      }
    },
    "behavior": {
      "type": "object",
      "description": "App behavior settings",
      "properties": {
        "idle_timeout_seconds": {
          "type": "integer",
          "description": "Seconds of inactivity before auto-close (0 to disable)",
          "minimum": 0,
          "default": 10
        },
        "always_on_top": {
          "type": "boolean",
          "description": "Keep window always on top",
          "default": true
        },
        "close_on_launch": {
          "type": "boolean",
          "description": "Close ARCYN after launching a mode",
          "default": true
        },
        "global_shortcut": {
          "type": "string",
          "description": "Global keyboard shortcut to toggle the ARCYN window from anywhere. Format: modifiers joined by '+' plus a key, e.g. 'Super+Space', 'Ctrl+Alt+Space'.",
          "pattern": "^(Ctrl|Alt|Shift|Meta|Super|cmd|win)([+](Ctrl|Alt|Shift|Meta|Super|cmd|win))*[+]([A-Za-z0-9]|F(1[0-9]|2[0-4]|[1-9])|Escape|Tab|Space|Enter|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right)$"
        }
      }
    },
    "modes": {
      "type": "array",
      "description": "List of workspace modes",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Mode display name (e.g. CODE, DESIGN, STUDY)"
          },
          "description": {
            "type": "string",
            "description": "Short description shown below the name"
          },
          "accent": {
            "type": "string",
            "description": "Per-mode accent color override (optional)",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "apps": {
            "type": "array",
            "description": "Applications to launch (Linux command, absolute executable path, or command with arguments)",
            "items": { "type": "string" },
            "examples": [["code", "gnome-terminal", "/usr/local/bin/app"]]
          },
          "websites": {
            "type": "array",
            "description": "Websites to open in default browser",
            "items": { "type": "string", "format": "uri" },
            "examples": [["https://github.com", "https://chatgpt.com"]]
          },
          "folders": {
            "type": "array",
            "description": "Folders to open with the default Linux file manager",
            "items": { "type": "string" },
            "examples": [["/home/user/Projects", "/home/me/Documents"]]
          },
          "shortcut": {
            "type": "string",
            "description": "Optional keyboard shortcut that launches this mode. Format: modifiers joined by '+' plus a key, e.g. 'Ctrl+Alt+1', 'ctrl+shift+F5', 'Super+K', 'F12'. If omitted, the implicit digit '1'..'9' launches modes by position.",
            "pattern": "^(Ctrl|Alt|Shift|Meta|Super|cmd|win)([+](Ctrl|Alt|Shift|Meta|Super|cmd|win))*[+]([A-Za-z0-9]|F(1[0-9]|2[0-4]|[1-9])|Escape|Tab|Space|Enter|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right)$",
            "examples": ["Ctrl+Alt+1", "Super+K", "F5"]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["modes"],
  "additionalProperties": false
}
